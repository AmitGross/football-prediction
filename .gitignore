# ── Active model artefacts (committed so users can run without training) ───
# model.pkl, classifier.pkl, dc_ratings.pkl, calibrator.pkl are committed.
# Versioned archive copies (model_wc*.pkl etc.) are NOT committed — regenerate
# them with: python main.py train --year <2018|2022|2026>

# ── Versioned model archives (large, regenerable) ─────────────────────────
model_wc*.pkl
classifier_wc*.pkl
dc_ratings_wc*.pkl
calibrator_wc*.pkl

# ── Runtime state ─────────────────────────────────────────────────────────
model_active.txt

# ── Temp / eval files ──────────────────────────────────────────────────────
data/matches_eval_tmp.csv

# ── Excel exports (generated — not committed) ──────────────────────────────
results_wc*.xlsx
predictions_wc2026_full*.xlsx
predictions_wc2026_full_with*.xlsx
predictions_wc2022_frozen.csv
predictions_wc2026.csv
~$*.xlsx

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Environments ──────────────────────────────────────────────────────────
.env
.venv
env/
venv/

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
